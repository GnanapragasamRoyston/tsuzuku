# Copier en .env et remplacer les valeurs. Ne jamais commiter .env.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=tsuzuku
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tsuzuku
# 5433 côté hôte pour ne pas entrer en conflit avec un Postgres local déjà sur 5432.
POSTGRES_PORT=5433

DATABASE_URL=postgresql://tsuzuku:change-me@localhost:5433/tsuzuku
# Le conteneur de l'API (make api-up) construit sa propre URL vers « db:5432 » à partir des
# variables POSTGRES_* : évite les caractères spéciaux (@ : / #) dans le mot de passe, ou
# encode-les en URL (%40 pour @…).

# --- Airflow (phase 6) ---
# Générés par `make airflow-keys` (valeurs aléatoires, jamais affichées) :
# AIRFLOW_UID=1000
# AIRFLOW_FERNET_KEY=
# AIRFLOW_SECRET_KEY=
# AIRFLOW_ADMIN_USER=admin
# AIRFLOW_ADMIN_PASSWORD=

# --- API (phase 5) ---
# Facultatif en local : valeurs par défaut = dossier models/ du dépôt et front sur :3000.
# MODELS_DIR=/chemin/vers/models
# CORS_ORIGINS=["http://localhost:3000"]

# --- Comptes (phase 7) ---
# Signe les sessions. Généré par `make api-keys` (valeur aléatoire, jamais affichée) ; sans lui,
# l'API démarre mais les routes de compte répondent 503.
# JWT_SECRET=
# Cookie de session réservé au HTTPS (défaut true). Les navigateurs l'acceptent aussi sur
# http://localhost ; ne mettre false que pour un autre hôte en http, jamais en production.
# COOKIE_SECURE=true

# --- Front (phase 8) ---
# Lu par le serveur Next (frontend/), jamais envoyé au navigateur : adresse de l'API vers laquelle
# il relaie /api/*. Défaut : http://127.0.0.1:8000 (make api). À mettre dans frontend/.env.local
# si besoin d'une autre valeur.
# API_URL=http://127.0.0.1:8000

# --- Kaggle (phase 1, make data) ---
# Méthode recommandée : jeton dans ~/.kaggle/access_token (chmod 600), hors du dépôt.
# Alternative (ex. CI) : décommenter et renseigner. Le jeton se crée sur kaggle.com → Settings.
# KAGGLE_API_TOKEN=
